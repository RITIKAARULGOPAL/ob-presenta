# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase cli scratch
/supabase/.temp/

# Paused AI-import feature. These import pdfjs-dist, which is deliberately not
# in package.json while the feature is on hold — so they compile locally off a
# stale node_modules but fail a clean Vercel build. `git add -A` swept them in
# once already (fixed in e4629f6); ignoring them stops that recurring.
/src/lib/importDeck.ts
/src/app/api/import-slide/

.vercel
.env*
